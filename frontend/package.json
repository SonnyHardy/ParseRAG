{
  "name": "parserag-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "prebuild": "node scripts/check-template-literals.mjs && node scripts/write-license.mjs",
    "prestart": "node scripts/check-template-literals.mjs && node scripts/write-license.mjs",
    "pretest": "node scripts/check-template-literals.mjs && node scripts/write-license.mjs",
    "prewatch": "node scripts/check-template-literals.mjs && node scripts/write-license.mjs",
    "test:watch": "ng test",
    "serve:dist": "node scripts/serve-dist.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "postbuild": "node scripts/check-prerender.mjs && node scripts/build-seo-files.mjs && node scripts/build-agent-files.mjs && node scripts/check-seo.mjs && node scripts/check-agent-files.mjs && node scripts/check-budget.mjs",
    "images:build": "node scripts/build-images.mjs && node scripts/build-og-image.mjs"
  },
  "private": true,
  "packageManager": "npm@11.10.0",
  "dependencies": {
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/ssr": "22.1.6",
    "@primeuix/themes": "3.0.0",
    "gsap": "^3.15.0",
    "primeicons": "8.0.0",
    "primeng": "22.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@types/node": "24.13.3",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
